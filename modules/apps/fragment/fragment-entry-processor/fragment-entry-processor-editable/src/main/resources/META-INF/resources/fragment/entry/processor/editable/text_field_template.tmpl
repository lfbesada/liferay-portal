[#if .vars["field_name"]??]
	[#if templateUtil.isSupplier(.vars["field_name"])]
		[#assign fieldValue=.vars["field_name"].get()]
	[#else]
		[#assign fieldValue=.vars["field_name"]]
	[/#if]
	
	[#if contentAccessorUtil.isContentAccessor(fieldValue)]
		${fieldValue.getContent()}
	[#elseif fieldValue?is_date_like]
		${fieldValue?datetime?string}
	[#elseif fieldValue?is_sequence && fieldValue?size > 0 && fieldValue?first?is_hash]
		${fieldValue?map(labeled -> labeled.getLabel(locale))?join(", ")}
	[#elseif fieldValue?is_sequence]
		${fieldValue?join(", ")}
	[#else]
		${fieldValue}
	[/#if]
[/#if]