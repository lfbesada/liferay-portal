[#if .vars["field_name"]??]
	[#if templateUtil.isSupplier(.vars["field_name"])]
		[#assign fieldValue=.vars["field_name"].get()]
	[#else]
		[#assign fieldValue=.vars["field_name"]]
	[/#if]
    [#if fieldValue?is_hash]
        [#if fieldValue.infoItemReference??]
			[#if fieldValue.infoItemReference.className?ends_with("FileEntry") && fieldValue.infoItemReference.infoItemIdentifier.classPK??]
				${fieldValue.infoItemReference.infoItemIdentifier.classPK}
			[/#if]
        [/#if]
    [/#if]
[/#if]