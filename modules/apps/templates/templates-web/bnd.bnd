Bundle-Name: Liferay Templates Web
Bundle-SymbolicName: com.liferay.templates.web
Bundle-Version: 1.0.0
Liferay-JS-Config: /META-INF/resources/js/config.js
Provide-Capability:\
	liferay.resource.bundle;\
		resource.bundle.aggregate:String="(bundle.symbolic.name=com.liferay.dynamic.data.lists.lang)";\
		resource.bundle.base.name="content.Language"
Web-ContextPath: /templates-web
-dsannotations-options: inherit